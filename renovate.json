{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>harunonsystem/.github:renovate-config"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["@raycast/api", "@types/node", "@types/react"],
      "groupName": "Raycast runtime"
    }
  ]
}
