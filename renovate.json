{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>harunonsystem/.github:renovate-config.jsonc",
    "local>harunonsystem/.github:renovate-npm-lockfile.jsonc"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "@raycast/api",
        "@types/node",
        "@types/react"
      ],
      "groupName": "Raycast runtime"
    }
  ]
}
